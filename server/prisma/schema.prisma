// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String?
  profilePhoto String   @default("https://imgs.search.brave.com/WBx1R5oxg9Xvx16skOUwdEjn007VZLJwqY_s-iCPHUg/rs:fit:500:0:1:0/g:ce/aHR0cHM6Ly9mcmVl/c3ZnLm9yZy9pbWcv/YWJzdHJhY3QtdXNl/ci1mbGF0LTQucG5n")
  interests    String[] @default([])
  role         Role     @default(USER)
  isVerified   Boolean  @default(false)
  isGoogleUser Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verificationToken   VerificationToken?
  passwordResetTokens PasswordResetToken[]
  coursesEnrolled     Enrollment[]
  coursesCreated      Course[]             @relation("InstructorCourses")
  lessonCompletions   LessonProgress[]
  Payment             Payment[]
  CartItem            CartItem[]

  @@index([name])
  @@index([createdAt])
}

model Course {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  thumbnail   String
  category    String
  price       Float    @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId String

  modules     Module[]
  enrollments Enrollment[]
  Payment     Payment[]    @relation("PaymentCourses")
  CartItem    CartItem[]

  // 🔥 Indexes to speed up search & filtering
  @@index([title])
  @@index([description])
  @@index([category])
  @@index([price])
  @@index([createdAt])
}

model Module {
  id        String   @id @default(uuid())
  title     String
  order     Int
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id       String  @id @default(uuid())
  title    String
  content  String // Markdown or HTML
  videoUrl String?
  order    Int
  module   Module  @relation(fields: [moduleId], references: [id])
  moduleId String

  quizzes     Quiz[]
  completions LessonProgress[]

  @@index([moduleId])
  @@index([order])
}

model Enrollment {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   String
  paymentId  String? // Razorpay Payment ID (if paid)
  enrolledAt DateTime @default(now())

  @@index([courseId])
  @@index([userId])
  @@index([courseId, userId])
  @@index([enrolledAt])
}

model CartItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // Prevent duplicate cart items
}

model Payment {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  courseId          String
  razorpayOrderId   String
  razorpayPaymentId String?
  amount            Int
  currency          String   @default("INR")
  status            String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt         DateTime @default(now())

  Course Course[] @relation("PaymentCourses")
}

model LessonProgress {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  lesson          Lesson    @relation(fields: [lessonId], references: [id])
  lessonId        String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  videoProgress   Float     @default(0.0) // Percentage (0.0 to 100.0)
  currentTime     Float     @default(0.0) // Current time in seconds
  duration        Float? // Total video duration in seconds
  watchedSegments Json? // Array of watched segments
  lastWatchedAt   DateTime? // Last time user watched

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

model Quiz {
  id        String     @id @default(uuid())
  lesson    Lesson     @relation(fields: [lessonId], references: [id])
  lessonId  String
  questions Question[]
}

model Question {
  id      String   @id @default(uuid())
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  quizId  String
  text    String
  options String[] // e.g. ["A", "B", "C", "D"]
  correct String
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Role {
  USER
  INSTRUCTOR
  ADMIN
}
